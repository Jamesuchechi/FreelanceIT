# ==============================================================================
# FreelanceIT - Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   apps/web/src/environments/environment.ts (Public frontend keys only)
#   supabase/.env (Local Edge Function secrets)
#
# CRITICAL SECURITY POLICY:
# - NEVER commit .env or environment.ts with production credentials to git.
# - SUPABASE_SERVICE_ROLE_KEY and PORTAL_TOKEN_PEPPER must NEVER be bundled in the Angular web client.
# - Only SUPABASE_URL and SUPABASE_ANON_KEY are safe for browser exposure.
# ==============================================================================

# Public Supabase Client (Angular web app)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# Edge Functions / Backend Secrets (Private, server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key
APP_BASE_URL=http://localhost:4200
PORTAL_TOKEN_PEPPER=local_development_portal_token_pepper_secret_128bit
EMAIL_API_KEY=test_email_api_key_resend_or_postmark
